    finalize(temp, sizeof(temp));
    formatHMACKey(state.m, key, keyLen, 0x5C);
    state.lengthLow += 128;
    state.chunkSize = 128;
    update(temp, sizeof(temp));
    finalize(hash, hashLen);
    clean(temp);
}


