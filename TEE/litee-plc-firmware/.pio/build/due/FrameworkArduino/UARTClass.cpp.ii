  p_emac->EMAC_USRIO |= (0x1u << 0);
 } else {
  p_emac->EMAC_USRIO &= ~(0x1u << 0);
 }
}







static inline void emac_enable_transceiver_clock(Emac* p_emac,
  uint8_t uc_enable)
{
 if (uc_enable) {
  p_emac->EMAC_USRIO |= (0x1u << 1);
 } else {
  p_emac->EMAC_USRIO &= ~(0x1u << 1);
 }
}

