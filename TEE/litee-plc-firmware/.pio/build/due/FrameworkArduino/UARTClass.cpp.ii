   b_ext_addr_match:1,
   b_uni_hash_match:1,
   b_multi_hash_match:1,
   b_boardcast_detect:1;
  } bm;
 } status;
} __attribute__ ((packed, aligned(8))) emac_rx_descriptor_t;


