class UARTClass : public HardwareSerial
{
  public:
    enum UARTModes {
      Mode_8N1 = (0x3u << 6) | (0x0u << 12) | (0x4u << 9),
      Mode_8E1 = (0x3u << 6) | (0x0u << 12) | (0x0u << 9),
      Mode_8O1 = (0x3u << 6) | (0x0u << 12) | (0x1u << 9),
      Mode_8M1 = (0x3u << 6) | (0x0u << 12) | (0x3u << 9),
      Mode_8S1 = (0x3u << 6) | (0x0u << 12) | (0x2u << 9),
    };
    UARTClass(Uart* pUart, IRQn_Type dwIrq, uint32_t dwId, RingBuffer* pRx_buffer, RingBuffer* pTx_buffer);

    void begin(const uint32_t dwBaudRate);
    void begin(const uint32_t dwBaudRate, const UARTModes config);
    void end(void);
    int available(void);
    int availableForWrite(void);
    int peek(void);
    int read(void);
    void flush(void);
    size_t write(const uint8_t c);
    using Print::write;

    void setInterruptPriority(uint32_t priority);
    uint32_t getInterruptPriority();

    void IrqHandler(void);

    operator bool() { return true; };

  protected:
    void init(const uint32_t dwBaudRate, const uint32_t config);

    RingBuffer *_rx_buffer;
    RingBuffer *_tx_buffer;

    Uart* _pUart;
    IRQn_Type _dwIrq;
    uint32_t _dwId;

};
# 23 "C:\\Users\\HUAWEI\\.platformio\\packages\\framework-arduino-sam\\cores\\arduino\\UARTClass.cpp" 2



UARTClass::UARTClass( Uart *pUart, IRQn_Type dwIrq, uint32_t dwId, RingBuffer *pRx_buffer, RingBuffer *pTx_buffer )
{
  _rx_buffer = pRx_buffer;
  _tx_buffer = pTx_buffer;

  _pUart=pUart;
  _dwIrq=dwIrq;
  _dwId=dwId;
}



void UARTClass::begin(const uint32_t dwBaudRate)
{
  begin(dwBaudRate, Mode_8N1);
}

void UARTClass::begin(const uint32_t dwBaudRate, const UARTModes config)
{
  uint32_t modeReg = static_cast<uint32_t>(config) & 0x00000E00;
  init(dwBaudRate, modeReg | (0x0u << 14));
}

void UARTClass::init(const uint32_t dwBaudRate, const uint32_t modeReg)
{

  pmc_enable_periph_clk( _dwId );


  _pUart->UART_PTCR = (0x1u << 1) | (0x1u << 9);


  _pUart->UART_CR = (0x1u << 2) | (0x1u << 3) | (0x1u << 5) | (0x1u << 7);


  _pUart->UART_MR = modeReg;


  _pUart->UART_BRGR = (SystemCoreClock / dwBaudRate) >> 4;


  _pUart->UART_IDR = 0xFFFFFFFF;
  _pUart->UART_IER = (0x1u << 0) | (0x1u << 5) | (0x1u << 6);


  NVIC_EnableIRQ(_dwIrq);


  _rx_buffer->_iHead = _rx_buffer->_iTail = 0;
  _tx_buffer->_iHead = _tx_buffer->_iTail = 0;


  _pUart->UART_CR = (0x1u << 4) | (0x1u << 6);
}

void UARTClass::end( void )
{

  _rx_buffer->_iHead = _rx_buffer->_iTail;


  flush();


  NVIC_DisableIRQ( _dwIrq );

  pmc_disable_periph_clk( _dwId );
}

void UARTClass::setInterruptPriority(uint32_t priority)
{
  NVIC_SetPriority(_dwIrq, priority & 0x0F);
}

uint32_t UARTClass::getInterruptPriority()
{
  return NVIC_GetPriority(_dwIrq);
}

int UARTClass::available( void )
{
  return (uint32_t)(128 + _rx_buffer->_iHead - _rx_buffer->_iTail) % 128;
}

int UARTClass::availableForWrite(void)
{
  int head = _tx_buffer->_iHead;
  int tail = _tx_buffer->_iTail;
  if (head >= tail) return 128 - 1 - head + tail;
  return tail - head - 1;
}

int UARTClass::peek( void )
{
  if ( _rx_buffer->_iHead == _rx_buffer->_iTail )
    return -1;

  return _rx_buffer->_aucBuffer[_rx_buffer->_iTail];
}

int UARTClass::read( void )
{

  if ( _rx_buffer->_iHead == _rx_buffer->_iTail )
    return -1;

  uint8_t uc = _rx_buffer->_aucBuffer[_rx_buffer->_iTail];
  _rx_buffer->_iTail = (unsigned int)(_rx_buffer->_iTail + 1) % 128;
  return uc;
}

void UARTClass::flush( void )
{
  while (_tx_buffer->_iHead != _tx_buffer->_iTail);

  while ((_pUart->UART_SR & (0x1u << 9)) != (0x1u << 9))
   ;
}

size_t UARTClass::write( const uint8_t uc_data )
{

  if (((_pUart->UART_SR & (0x1u << 1)) != (0x1u << 1)) |
      (_tx_buffer->_iTail != _tx_buffer->_iHead))
  {

    int nextWrite = (_tx_buffer->_iHead + 1) % 128;
    while (_tx_buffer->_iTail == nextWrite)
      ;

    _tx_buffer->_aucBuffer[_tx_buffer->_iHead] = uc_data;
    _tx_buffer->_iHead = nextWrite;

    _pUart->UART_IER = (0x1u << 1);
  }
  else
  {

     _pUart->UART_THR = uc_data;
  }
  return 1;
}

void UARTClass::IrqHandler( void )
{
  uint32_t status = _pUart->UART_SR;


  if ((status & (0x1u << 0)) == (0x1u << 0))
    _rx_buffer->store_char(_pUart->UART_RHR);


  if ((status & (0x1u << 1)) == (0x1u << 1))
  {
    if (_tx_buffer->_iTail != _tx_buffer->_iHead) {
      _pUart->UART_THR = _tx_buffer->_aucBuffer[_tx_buffer->_iTail];
      _tx_buffer->_iTail = (unsigned int)(_tx_buffer->_iTail + 1) % 128;
    }
    else
    {

      _pUart->UART_IDR = (0x1u << 1);
    }
  }


  if ((status & (0x1u << 5)) == (0x1u << 5) || (status & (0x1u << 6)) == (0x1u << 6))
  {

    _pUart->UART_CR |= (0x1u << 8);
  }
}
